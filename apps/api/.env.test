# Test environment - fully self-contained so `pnpm test` works on a fresh
# clone with no other setup. Committed on purpose (see .gitignore); the
# APP_KEY below only ever encrypts session data in the disposable test
# SQLite file, never anything real.
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=test
LOG_LEVEL=info
APP_KEY=jET_bOyLt5PxUOn72s4poMgXWzkfeetL
APP_URL=http://${HOST}:${PORT}

SESSION_DRIVER=memory
DB_FILENAME=./tmp/test.sqlite3

AUTHENTIK_PROXY_AUTH_ENABLED=true
AUTHENTIK_SHARED_SECRET=test-authentik-shared-secret

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Seed data: path to the .xlsx workbook whose "Users" sheet (Name, Email,
# Password columns) `node ace db:seed` reads to create logins, used once.
SEED_WORKBOOK_PATH=

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

#--------------------------------------------------------------------
# Authentik reverse-proxy auto-login (optional, off by default)
#--------------------------------------------------------------------
# Set up an Authentik proxy provider in front of this app, add a custom
# header property mapping that sends a fixed secret as
# X-Authentik-Shared-Secret, then set both of these to match. When set,
# a request bearing the correct secret auto-logs-in as the local user
# whose email matches the X-authentik-email header Authentik sends -
# only enable this if the proxy is the sole path to the app.
# AUTHENTIK_PROXY_AUTH_ENABLED=true
# AUTHENTIK_SHARED_SECRET=
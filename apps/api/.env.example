# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Seed data (used once by `node ace db:seed` to create the two household logins)
SEED_BRIAN_EMAIL=
SEED_BRIAN_PASSWORD=
SEED_ARIEL_EMAIL=
SEED_ARIEL_PASSWORD=

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000
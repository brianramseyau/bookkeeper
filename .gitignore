node_modules
.env
.env.*
!.env.example
!.env.test

# Claude Code local settings (machine-specific, not project config)
.claude/

apps/api/build
apps/api/tmp/*
!apps/api/tmp/.gitkeep
apps/api/.adonisjs
apps/api/coverage
# apps/api/public holds the built SvelteKit SPA, copied in by `pnpm build` -
# it's a build artifact, not source.
apps/api/public/*
!apps/api/public/.gitkeep

apps/web/.svelte-kit
apps/web/build
apps/web/coverage

*.sqlite3
*.sqlite3-wal
*.sqlite3-shm

.DS_Store
*.xlsx
!apps/api/tests/fixtures/*.xlsx


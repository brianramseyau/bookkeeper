# Copy to .env and fill in before running `docker compose up`.
# Used by docker-compose.yml to fill in the container's environment.

# Generate with: docker run --rm bookkeeper:latest node ace generate:key
APP_KEY=

# One-time seed data - only consumed by the manual
# `docker compose exec bookkeeper node ace db:seed` step that creates the
# two logins, but must still be set for the container to boot (the app
# validates all required env vars on startup).
SEED_BRIAN_EMAIL=
SEED_BRIAN_PASSWORD=
SEED_ARIEL_EMAIL=
SEED_ARIEL_PASSWORD=

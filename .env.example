# Copy to .env and fill in before running `docker compose up`.
# Used by docker-compose.yml to fill in the container's environment.

# Generate with: docker run --rm bookkeeper:latest node ace generate:key
APP_KEY=

# One-time seed data - only consumed by the manual
# `docker compose exec bookkeeper node ace db:seed` step that creates
# logins from the workbook's "Users" sheet (Name, Email, Password columns),
# but must still be set for the container to boot (the app validates all
# required env vars on startup). Place your workbook in the appdata data
# directory (see docker-compose.yml) and point this at it inside the
# container, e.g. /app/data/Joint Account Workbook.xlsx
SEED_WORKBOOK_PATH=
